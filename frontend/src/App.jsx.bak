import React, { useState } from 'react';
import { 
  Radio, Upload, Play, Pause, Globe, Settings2, 
  Sparkles, CheckCircle2, Volume2, FileAudio,
  User, UserCheck, Download, RefreshCw, Zap, Activity, Layers, ShieldCheck
} from 'lucide-react';

const LANGUAGES = [
  { code: 'ar', name: 'العربية', flag: '🇪🇬' },
  { code: 'en', name: 'الإنجليزية', flag: '🇺🇸' },
  { code: 'fr', name: 'الفرنسية', flag: '🇫🇷' },
  { code: 'es', name: 'الإسبانية', flag: '🇪🇸' },
  { code: 'de', name: 'الألمانية', flag: '🇩🇪' },
  { code: 'it', name: 'الإيطالية', flag: '🇮🇹' },
  { code: 'pt', name: 'البرتغالية', flag: '🇵🇹' },
  { code: 'ru', name: 'الروسية', flag: '🇷🇺' },
  { code: 'zh', name: 'الصينية', flag: '🇨🇳' },
  { code: 'ja', name: 'اليابانية', flag: '🇯🇵' },
  { code: 'ko', name: 'الكورية', flag: '🇰🇷' },
  { code: 'tr', name: 'التركية', flag: '🇹🇷' },
  { code: 'hi', name: 'الهندية', flag: '🇮🇳' },
  { code: 'ur', name: 'الأوردية', flag: '🇵🇰' },
  { code: 'fa', name: 'الفارسية', flag: '🇮🇷' },
  { code: 'id', name: 'الإندونيسية', flag: '🇮🇩' },
  { code: 'pl', name: 'البولندية', flag: '🇵🇱' },
  { code: 'nl', name: 'الهولندية', flag: '🇳🇱' },
  { code: 'sv', name: 'السويدية', flag: '🇸🇪' },
  { code: 'el', name: 'اليونانية', flag: '🇬🇷' },
  { code: 'ro', name: 'الرومانية', flag: '🇷🇴' },
  { code: 'cs', name: 'التشيكية', flag: '🇨🇿' },
  { code: 'hu', name: 'المجرية', flag: '🇭🇺' },
  { code: 'da', name: 'الدنماركية', flag: '🇩🇰' },
  { code: 'fi', name: 'الفنلندية', flag: '🇫🇮' },
  { code: 'no', name: 'النرويجية', flag: '🇳🇴' },
  { code: 'uk', name: 'الأوكرانية', flag: '🇺🇦' },
  { code: 'th', name: 'التايلاندية', flag: '🇹🇭' },
  { code: 'vi', name: 'الفيتنامية', flag: '🇻🇳' },
  { code: 'ms', name: 'الملايوية', flag: '🇲🇾' },
  { code: 'bn', name: 'البنغالية', flag: '🇧🇩' },
  { code: 'fil', name: 'الفلبينية', flag: '🇵🇭' },
  { code: 'sw', name: 'السواحيلية', flag: '🇹🇿' },
  { code: 'ta', name: 'التاميلية', flag: '🇱🇰' },
  { code: 'te', name: 'التيلوغوية', flag: '🇮🇳' },
  { code: 'mr', name: 'المراثية', flag: '🇮🇳' },
  { code: 'gu', name: 'الغوجاراتية', flag: '🇮🇳' },
  { code: 'kn', name: 'الكانادية', flag: '🇮🇳' },
  { code: 'ml', name: 'المالايالامية', flag: '🇮🇳' },
  { code: 'pa', name: 'البنجابية', flag: '🇵🇰' },
  { code: 'kk', name: 'الكازاخية', flag: '🇰🇿' },
  { code: 'uz', name: 'الأوزبكية', flag: '🇺🇿' },
  { code: 'az', name: 'الأذربيجانية', flag: '🇦🇿' },
  { code: 'sq', name: 'الألبانية', flag: '🇦🇱' },
  { code: 'sr', name: 'الصربية', flag: '🇷🇸' },
  { code: 'hr', name: 'الكرواتية', flag: '🇭🇷' },
  { code: 'sk', name: 'السلوفاكية', flag: '🇸🇰' },
  { code: 'bg', name: 'البلغارية', flag: '🇧🇬' },
  { code: 'lt', name: 'الليتوانية', flag: '🇱🇹' },
  { code: 'lv', name: 'اللاتفية', flag: '🇱🇻' }
];

export default function App() {
  const [file, setFile] = useState(null);
  const [targetLang, setTargetLang] = useState('ar');
  const [voiceType, setVoiceType] = useState('male');
  const [pitch, setPitch] = useState(1.0);
  const [speed, setSpeed] = useState(1.0);
  const [isProcessing, setIsProcessing] = useState(false);
  const [progress, setProgress] = useState(0);
  const [statusText, setStatusText] = useState('');
  const [isReady, setIsReady] = useState(false);
  const [isPlaying, setIsPlaying] = useState(false);

  const handleFileUpload = (e) => {
    if (e.target.files && e.target.files[0]) {
      setFile(e.target.files[0]);
      setIsReady(false); setIsPlaying(false);
    }
  };

  const handleStartDubbing = () => {
    if (!file) return;
    setIsProcessing(true); setProgress(0); setIsReady(false); setIsPlaying(false);
    const steps = [
      { p: 20, text: 'جاري استخراج وتحليل البصمة الصوتية...' },
      { p: 45, text: 'جاري الترجمة الذكية عبر شبكة العصبيات...' },
      { p: 75, text: 'جاري توليد الطبقات الصوتية الفائقة...' },
      { p: 100, text: 'اكتملت الدبلجة الأسطورية بنجاح!' }
    ];
    let currentStep = 0;
    const interval = setInterval(() => {
      if (currentStep < steps.length) {
        setProgress(steps[currentStep].p);
        setStatusText(steps[currentStep].text);
        currentStep++;
      } else {
        clearInterval(interval); setIsProcessing(false); setIsReady(true);
      }
    }, 800);
  };

  return (
    <div dir="rtl" className="min-h-screen bg-[#070514] text-white flex flex-col font-sans selection:bg-cyan-500 selection:text-white relative overflow-hidden">
      
      {/* Dynamic Cyberpunk Lighting Effects */}
      <div className="fixed inset-0 pointer-events-none z-0">
        <div className="absolute top-[-15%] right-[-10%] w-[55%] h-[55%] bg-cyan-600/20 rounded-full blur-[180px] mix-blend-screen animate-pulse"></div>
        <div className="absolute bottom-[-15%] left-[-10%] w-[55%] h-[55%] bg-fuchsia-600/20 rounded-full blur-[180px] mix-blend-screen animate-pulse"></div>
        <div className="absolute top-[30%] left-[30%] w-[40%] h-[40%] bg-indigo-600/15 rounded-full blur-[150px] mix-blend-screen"></div>
        <div className="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] opacity-25"></div>
      </div>

      {/* Header */}
      <header className="relative z-10 border-b border-white/10 bg-[#070514]/80 backdrop-blur-2xl sticky top-0 shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
        <div className="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
          <div className="flex items-center gap-4">
            <div className="p-3 bg-gradient-to-tr from-cyan-500 via-indigo-600 to-fuchsia-500 rounded-2xl shadow-[0_0_25px_rgba(6,182,212,0.5)] border border-white/20">
              <Radio className="w-7 h-7 text-white animate-pulse" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h1 className="font-extrabold text-3xl tracking-tight bg-gradient-to-r from-cyan-400 via-indigo-200 to-fuchsia-400 bg-clip-text text-transparent drop-shadow-[0_2px_10px_rgba(6,182,212,0.3)]">
                  LinguaCast
                </h1>
                <span className="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                  ULTIMATE AI
                </span>
              </div>
              <p className="text-xs text-cyan-200/70 font-medium mt-1">منظومة الدبلجة السينمائية بالذكاء الاصطناعي</p>
            </div>
          </div>
          <div className="flex items-center gap-3">
            <span className="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 shadow-[0_0_20px_rgba(16,185,129,0.2)]">
              <span className="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
              النظام خارق وجاهز
            </span>
          </div>
        </div>
      </header>

      {/* Main Grid */}
      <main className="relative z-10 flex-1 max-w-7xl w-full mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        {/* Right Section: Control Panel */}
        <div className="lg:col-span-7 space-y-6">
          
          {/* File Upload Box */}
          <div className="bg-white/[0.03] border border-white/10 rounded-3xl p-6 backdrop-blur-xl shadow-2xl relative overflow-hidden group hover:border-cyan-500/40 transition-all duration-500">
            <div className="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div className="flex items-center justify-between mb-4 relative z-10">
              <h2 className="text-xl font-bold flex items-center gap-2.5 text-cyan-300">
                <Upload className="w-6 h-6 text-cyan-400" />
                رفع الملف الصوتي أو الفيديو
              </h2>
              <span className="text-xs text-cyan-400/80 bg-cyan-950/60 px-3 py-1 rounded-full font-mono border border-cyan-500/20">حتى 500MB</span>
            </div>
            
            <label className="border-2 border-dashed border-cyan-500/30 hover:border-cyan-400 transition-all duration-300 rounded-2xl p-8 flex flex-col items-center justify-center cursor-pointer bg-black/30 hover:bg-cyan-500/5 relative z-10">
              <input type="file" accept="audio/*,video/*" className="hidden" onChange={handleFileUpload} />
              <div className="p-4 rounded-2xl bg-gradient-to-br from-cyan-500 to-indigo-600 mb-4 shadow-[0_0_25px_rgba(6,182,212,0.4)] group-hover:scale-110 transition-transform">
                <FileAudio className="w-10 h-10 text-white" />
              </div>
              {file ? (
                <p className="text-base font-bold text-emerald-400 flex items-center gap-2">
                  <CheckCircle2 className="w-6 h-6" /> {file.name}
                </p>
              ) : (
                <div className="text-center">
                  <p className="text-base font-bold text-white mb-1">اضغط للرفع أو اسحب الملف هنا</p>
                  <p className="text-xs text-cyan-200/50">MP3, WAV, AAC, MP4, MKV</p>
                </div>
              )}
            </label>
          </div>

          {/* Settings Box */}
          <div className="bg-white/[0.03] border border-white/10 rounded-3xl p-6 backdrop-blur-xl shadow-2xl space-y-6">
            <h2 className="text-xl font-bold flex items-center gap-2.5 text-indigo-300 border-b border-white/10 pb-4">
              <Settings2 className="w-6 h-6 text-indigo-400" />
              خيارات اللغات (50 لغة) وصوت المتحدث
            </h2>

            {/* 50 Languages Selection */}
            <div>
              <label className="block text-sm font-bold text-indigo-200 mb-3 flex items-center gap-2">
                <Globe className="w-5 h-5 text-indigo-400" /> اختر اللغة المستهدفة بدقة
              </label>
              <div className="relative">
                <select 
                  value={targetLang} 
                  onChange={(e) => setTargetLang(e.target.value)}
                  className="w-full bg-black/50 border border-indigo-500/30 focus:border-cyan-400 rounded-2xl px-4 py-4 text-base focus:outline-none focus:ring-2 focus:ring-cyan-500/40 text-white transition-all font-bold cursor-pointer appearance-none shadow-inner"
                >
                  {LANGUAGES.map((lang) => (
                    <option key={lang.code} value={lang.code} className="bg-[#0f0c29] text-white font-medium py-2">
                      {lang.flag} {lang.name}
                    </option>
                  ))}
                </select>
                <div className="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none text-indigo-400">
                  ▼
                </div>
              </div>
            </div>

            {/* Voice Gender Selection */}
            <div className="grid grid-cols-2 gap-4">
              <button
                type="button"
                onClick={() => setVoiceType('male')}
                className={`p-4 rounded-2xl border-2 flex items-center gap-4 transition-all duration-300 ${
                  voiceType === 'male'
                    ? 'border-cyan-500 bg-cyan-500/15 text-white shadow-[0_0_20px_rgba(6,182,212,0.3)] scale-[1.02]'
                    : 'border-white/10 bg-black/20 text-white/50 hover:bg-white/5'
                }`}
              >
                <div className={`p-3 rounded-xl ${voiceType === 'male' ? 'bg-cyan-500 text-black shadow-md' : 'bg-white/10'}`}>
                  <UserCheck className="w-6 h-6" />
                </div>
                <div className="text-right">
                  <p className="text-base font-bold mb-0.5">صوت رجالي</p>
                  <p className="text-xs text-cyan-200/60">عميق وواضح</p>
                </div>
              </button>

              <button
                type="button"
                onClick={() => setVoiceType('female')}
                className={`p-4 rounded-2xl border-2 flex items-center gap-4 transition-all duration-300 ${
                  voiceType === 'female'
                    ? 'border-fuchsia-500 bg-fuchsia-500/15 text-white shadow-[0_0_20px_rgba(217,70,239,0.3)] scale-[1.02]'
                    : 'border-white/10 bg-black/20 text-white/50 hover:bg-white/5'
                }`}
              >
                <div className={`p-3 rounded-xl ${voiceType === 'female' ? 'bg-fuchsia-500 text-white shadow-md' : 'bg-white/10'}`}>
                  <UserCheck className="w-6 h-6" />
                </div>
                <div className="text-right">
                  <p className="text-base font-bold mb-0.5">صوت نسائي</p>
                  <p className="text-xs text-fuchsia-200/60">ناعم واحترافي</p>
                </div>
              </button>
            </div>

            {/* Sliders */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
              <div className="bg-black/30 p-4 rounded-2xl border border-white/5 shadow-inner">
                <div className="flex justify-between items-center text-sm font-bold text-cyan-200 mb-2">
                  <span>طبقة الصوت (Pitch)</span>
                  <span className="font-mono bg-cyan-500/20 px-2 py-0.5 rounded text-cyan-300 text-xs">{pitch}x</span>
                </div>
                <input 
                  type="range" min="0.5" max="1.5" step="0.1" value={pitch} onChange={(e) => setPitch(parseFloat(e.target.value))}
                  className="w-full accent-cyan-400 bg-white/10 rounded-lg h-2 cursor-pointer"
                />
              </div>

              <div className="bg-black/30 p-4 rounded-2xl border border-white/5 shadow-inner">
                <div className="flex justify-between items-center text-sm font-bold text-fuchsia-200 mb-2">
                  <span>سرعة الإلقاء (Speed)</span>
                  <span className="font-mono bg-fuchsia-500/20 px-2 py-0.5 rounded text-fuchsia-300 text-xs">{speed}x</span>
                </div>
                <input 
                  type="range" min="0.5" max="2.0" step="0.1" value={speed} onChange={(e) => setSpeed(parseFloat(e.target.value))}
                  className="w-full accent-fuchsia-400 bg-white/10 rounded-lg h-2 cursor-pointer"
                />
              </div>
            </div>

            {/* Action Button */}
            <button
              onClick={handleStartDubbing} disabled={!file || isProcessing}
              className={`w-full py-5 px-6 rounded-2xl font-extrabold text-xl flex items-center justify-center gap-3 transition-all duration-300 mt-2 ${
                !file 
                  ? 'bg-white/5 text-white/30 cursor-not-allowed border border-white/10'
                  : isProcessing
                  ? 'bg-gradient-to-r from-cyan-600 to-fuchsia-600 cursor-wait animate-pulse shadow-[0_0_35px_rgba(6,182,212,0.5)]'
                  : 'bg-gradient-to-r from-cyan-500 via-indigo-600 to-fuchsia-500 hover:scale-[1.02] shadow-[0_0_30px_rgba(6,182,212,0.4)] text-white'
              }`}
            >
              {isProcessing ? <RefreshCw className="w-7 h-7 animate-spin" /> : <Sparkles className="w-7 h-7 text-yellow-300 animate-spin" />}
              <span>{isProcessing ? 'جاري السحر والترجمة الفورية...' : 'بدء الدبلجة الأسطورية الآن'}</span>
            </button>
          </div>
        </div>

        {/* Left Section: Live Output Screen */}
        <div className="lg:col-span-5">
          <div className="bg-white/[0.03] border border-white/10 rounded-3xl p-6 backdrop-blur-xl shadow-2xl h-full flex flex-col justify-between relative overflow-hidden">
            <div className="absolute inset-0 bg-gradient-to-t from-cyan-950/30 to-transparent pointer-events-none"></div>
            
            <div className="relative z-10">
              <div className="flex items-center justify-between border-b border-white/10 pb-5 mb-6">
                <h2 className="text-xl font-bold flex items-center gap-2.5 text-white">
                  <Volume2 className="w-6 h-6 text-cyan-400" /> شاشة التشغيل الحية
                </h2>
                <ShieldCheck className="w-5 h-5 text-emerald-400" />
              </div>

              <div className="bg-black/50 border border-white/10 rounded-2xl p-6 flex flex-col items-center justify-center min-h-[420px] text-center shadow-inner relative">
                
                {isProcessing ? (
                  <div className="space-y-8 w-full max-w-xs">
                    <div className="relative flex justify-center">
                      <div className="w-28 h-28 border-4 border-cyan-500/20 border-t-cyan-400 rounded-full animate-spin shadow-[0_0_30px_rgba(6,182,212,0.6)]"></div>
                      <Zap className="w-10 h-10 text-cyan-300 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 animate-bounce" />
                    </div>
                    <div className="space-y-3">
                      <div className="flex justify-between text-base font-bold font-mono text-cyan-300">
                        <span>{progress}%</span> <span>جاري المعالجة</span>
                      </div>
                      <div className="w-full bg-white/10 rounded-full h-4 overflow-hidden p-0.5">
                        <div className="bg-gradient-to-r from-cyan-400 to-fuchsia-500 h-full rounded-full transition-all duration-300 shadow-[0_0_10px_rgba(6,182,212,0.8)]" style={{ width: `${progress}%` }}></div>
                      </div>
                    </div>
                    <p className="text-sm text-cyan-100 font-bold bg-cyan-950/50 py-3 px-4 rounded-xl border border-cyan-500/30 animate-pulse">{statusText}</p>
                  </div>
                ) : isReady ? (
                  <div className="space-y-8 w-full">
                    <div className="p-4 bg-emerald-500/20 border border-emerald-500/40 rounded-2xl flex items-center justify-center gap-3 text-emerald-300 text-base font-bold shadow-[0_0_25px_rgba(16,185,129,0.3)]">
                      <CheckCircle2 className="w-6 h-6" /> تمت الدبلجة بنجاح خارق!
                    </div>
                    
                    <div className="flex flex-col items-center gap-4">
                      <button 
                        onClick={() => setIsPlaying(!isPlaying)}
                        className={`p-8 rounded-full text-white transition-all duration-300 ${
                          isPlaying 
                            ? 'bg-gradient-to-tr from-fuchsia-600 to-pink-600 shadow-[0_0_35px_rgba(217,70,239,0.7)] animate-pulse scale-105'
                            : 'bg-gradient-to-tr from-cyan-500 to-indigo-600 hover:scale-110 shadow-[0_0_25px_rgba(6,182,212,0.6)]'
                        }`}
                      >
                        {isPlaying ? <Pause className="w-10 h-10" /> : <Play className="w-10 h-10 translate-x-1" />}
                      </button>
                      <span className="text-xs text-cyan-200/70 font-semibold">{isPlaying ? 'تشغيل المقطع الصوتي...' : 'اضغط للاستماع'}</span>
                    </div>
                    
                    {/* Visualizer Wave */}
                    <div className="flex items-center justify-center gap-2 h-20 bg-black/60 p-4 rounded-2xl border border-white/10 shadow-inner">
                      {[35, 65, 45, 85, 60, 100, 40, 75, 90, 55, 80, 50, 70, 95, 45].map((h, i) => (
                        <div 
                          key={i} 
                          className={`w-2 rounded-full transition-all duration-300 ${isPlaying ? 'bg-cyan-400 shadow-[0_0_12px_rgba(6,182,212,0.9)]' : 'bg-white/25'}`} 
                          style={{ height: isPlaying ? `${Math.max(25, (h * Math.random()).toFixed(0))}%` : `${h}%` }}
                        />
                      ))}
                    </div>

                    <button className="w-full py-4 px-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white border border-white/20 text-base font-bold flex items-center justify-center gap-3 transition-all hover:shadow-lg">
                      <Download className="w-5 h-5 text-cyan-300" /> تحميل المقطع النهائي برابط مباشر (MP3)
                    </button>
                  </div>
                ) : (
                  <div className="space-y-4 flex flex-col items-center opacity-60">
                    <div className="p-5 bg-white/5 rounded-full border border-white/10">
                      <Activity className="w-12 h-12 text-cyan-400" />
                    </div>
                    <p className="text-base font-bold text-white max-w-[220px]">جاهز لاستقبال ملفك وصنع المعجزة الصوتية</p>
                  </div>
                )}
              </div>
            </div>

            {/* Footer Tag */}
            <div className="mt-6 pt-4 border-t border-white/10 text-xs text-cyan-300/80 flex justify-between items-center font-mono font-bold bg-black/30 px-4 py-3 rounded-xl">
              <span className="flex items-center gap-1.5"><Layers className="w-4 h-4 text-cyan-400" /> 50 لغة عالمية</span>
              <span className="text-emerald-400">حماية فائقة • بدون قيود</span>
            </div>

          </div>
        </div>

      </main>
    </div>
  );
}
